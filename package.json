{
  "name": "@maholla/skeleton",
  "version": "0.1.5",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "description": "A Bun-based web server framework",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
