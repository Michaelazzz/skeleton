  "files": [
    "dist"
  ],
  "dependencies": {
    "bun-types": "^1.1.34"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maholla/skeleton.git"
  },
